{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_report_placement.py\" --hook",
            "timeout": 30,
            "statusMessage": "檢查報告存放位置"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_report_placement.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
